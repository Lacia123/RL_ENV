{
  "original": {
    "name": "原始尺寸",
    "description": "保持图片原始尺寸",
    "defaultStyle": {
      "width": "auto",
      "height": "auto",
      "maxWidth": "100%",
      "objectFit": "none"
    }
  },
  "contain": {
    "name": "完整适应",
    "description": "保持比例完整显示图片",
    "defaultStyle": {
      "width": "100%",
      "height": "100%",
      "objectFit": "contain"
    }
  },
  "cover": {
    "name": "填充覆盖",
    "description": "填充容器可能裁剪图片",
    "defaultStyle": {
      "width": "100%",
      "height": "100%",
      "objectFit": "cover"
    }
  },
  "square": {
    "name": "正方形",
    "description": "强制图片为正方形",
    "defaultStyle": {
      "width": "100%",
      "height": "0",
      "paddingBottom": "100%",
      "objectFit": "cover",
      "position": "relative"
    }
  },
  "16-9": {
    "name": "16:9比例",
    "description": "宽屏比例",
    "defaultStyle": {
      "width": "100%",
      "height": "0",
      "paddingBottom": "56.25%",
      "objectFit": "cover",
      "position": "relative"
    }
  },
  "4-3": {
    "name": "4:3比例",
    "description": "标准屏幕比例",
    "defaultStyle": {
      "width": "100%",
      "height": "0",
      "paddingBottom": "75%",
      "objectFit": "cover",
      "position": "relative"
    }
  }
} 