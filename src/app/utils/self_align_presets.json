{
  "self-start": {
    "name": "顶部/左侧对齐",
    "description": "元素自身对齐于父容器起始位置",
    "defaultStyle": {
      "alignSelf": "flex-start",
      "justifySelf": "flex-start"
    }
  },
  "self-center": {
    "name": "居中对齐",
    "description": "元素自身居中对齐",
    "defaultStyle": {
      "alignSelf": "center",
      "justifySelf": "center"
    }
  },
  "self-end": {
    "name": "底部/右侧对齐",
    "description": "元素自身对齐于父容器结束位置",
    "defaultStyle": {
      "alignSelf": "flex-end",
      "justifySelf": "flex-end"
    }
  },
  "self-stretch": {
    "name": "自身拉伸",
    "description": "元素自身拉伸填充父容器",
    "defaultStyle": {
      "alignSelf": "stretch",
      "justifySelf": "stretch"
    }
  }
} 