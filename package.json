{
  "name": "model-env",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "next build && node scripts/copy-server-files.js",
    "start": "cross-env NODE_ENV=production node server.js",
    "start:prod": "cross-env NODE_ENV=production node .next/server.js",
    "start:dev": "cross-env NODE_ENV=development node .next/server.js",
    "start:alpha": "cross-env NODE_ENV=alpha node .next/server.js",
    "prepare-deploy": "cd .next && npm install --production"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.6.1",
    "body-parser": "^1.20.2",
    "chart.js": "^4.4.8",
    "chroma-js": "^3.1.2",
    "colord": "^2.9.3",
    "cors": "^2.8.5",
    "d3-hierarchy": "^3.1.2",
    "express": "^4.21.2",
    "fs-extra": "^11.2.0",
    "jsdom": "^26.1.0",
    "mathjs": "^14.3.0",
    "next": "15.1.7",
    "node-fetch": "^2.7.0",
    "playwright-chromium": "^1.52.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-measure": "^2.5.2",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1"
  }
}
